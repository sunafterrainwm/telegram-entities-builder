{
	"name": "@sunafterrainwm/telegram-entities-builder",
	"version": "0.4.0",
	"author": {
		"name": "sunafterrainwm",
		"email": "sunafterrainwm@gmail.com"
	},
	"keywords": [
		"telegram",
		"entities",
		"message",
		"builder",
		"grammy",
		"bot",
		"api",
		"formatting",
		"text",
		"composition"
	],
	"license": "BSD-3-Clause",
	"description": "A powerful and flexible builder for creating and manipulating Telegram message entities.",
	"repository": {
		"url": "https://github.com/sunafterrainwm/telegram-entities-builder",
		"type": "git"
	},
	"files": [
		"AGENTS.md",
		"CHANGELOG.md",
		"agents",
		"dist",
		"src",
		"skills",
		"llms.txt",
		"llms-full.txt"
	],
	"type": "module",
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.cts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"scripts": {
		"build": "tsdown && pnpm run docs",
		"lint": "eslint . --fix",
		"test": "tsc && jest",
		"prepare": "husky",
		"docs": "typedoc"
	},
	"lint-staged": {
		"!(*js|*.ts)": "prettier --ignore-unknown --write",
		"*js|*.ts": [
			"eslint --fix",
			"prettier --write"
		]
	},
	"packageManager": "pnpm@10.34.8+sha512.f627a8e971343afe49dfd0f63d028234201dfa831d5cb588733e1e5f8db26bf16989a32161ab5c1b4db3b1fdbc373160606b5b89e002df6dd19a85adf91fc5a8",
	"devDependencies": {
		"@eslint/compat": "^1.2.4",
		"@eslint/js": "^9.17.0",
		"@grammyjs/types": "^5.0.0",
		"@jest/globals": "^30.4.1",
		"@skillit/typedoc": "^1.1.0",
		"@stylistic/eslint-plugin": "^2.12.1",
		"@swc/core": "^1.15.40",
		"@swc/jest": "^0.2.39",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/jest": "^30.0.0",
		"@types/lodash-es": "^4.17.12",
		"@types/node": "^22.10.2",
		"cheerio": "^1.0.0",
		"eslint": "^9.24.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"husky": "^9.1.7",
		"jest": "^29.7.0",
		"lint-staged": "^17.0.7",
		"ts-jest": "^29.4.11",
		"tsdown": "^0.22.2",
		"typedoc": "^0.28.19",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.18.1"
	},
	"peerDependencies": {
		"@grammyjs/types": ">=5.0.0"
	},
	"engines": {
		"node": ">=18"
	}
}
