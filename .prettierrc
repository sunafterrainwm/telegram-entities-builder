{
	"printWidth": 120,
	"singleQuote": true,
	"semi": true,
	"useTabs": true,
	"plugins": ["@trivago/prettier-plugin-sort-imports"],
	"importOrder": [
		"<BUILTIN_MODULES>",
		"<THIRD_PARTY_MODULES>",
		"^@lib/",
		"^\\.\\./(?!.*\\.vue$).*",
		"^\\./(?!.*\\.vue$)[^/]*",
		"\\.vue$"
	],
	"importOrderSeparation": true,
	"importOrderCaseInsensitive": false,
	"importOrderSortSpecifiers": true,
	"importOrderImportAttributesKeyword": "with"
}
